# ---------------------------------------------------------------
# Secrets  (NEVER commit — use .env.example as the template)
# ---------------------------------------------------------------
.env
.env.*
!.env.example
*.key
*.pem
credentials.json
token.json

# ---------------------------------------------------------------
# Large / generated data  (the heavy stuff — keep out of GitHub)
# ---------------------------------------------------------------
data/raw/*
data/output/*
data/cache/*
!data/raw/.gitkeep
!data/output/.gitkeep

# keep the small sample fixture used by tests
!data/fixtures/
!data/fixtures/**

# archives & bulky artifacts
*.zip
*.tar
*.tar.gz
*.tgz
*.7z
*.rar
*.gz
*.bz2

# generated reports / exports
*.pdf
*.xlsx
*.parquet
*.db
*.sqlite
*.sqlite3

# ---------------------------------------------------------------
# Python
# ---------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib64/
sdist/
wheels/
*.egg-info/
*.egg
.installed.cfg
MANIFEST

# virtual environments
venv/
.venv/
env/
.env/
ENV/
virtualenv/

# testing / coverage / type checking
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/
.cache
nosetests.xml
coverage.xml
*.cover
.hypothesis/
.mypy_cache/
.dmypy.json
.pyre/
.ruff_cache/

# jupyter
.ipynb_checkpoints/

# ---------------------------------------------------------------
# Node (in case the web frontend grows a build step)
# ---------------------------------------------------------------
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# ---------------------------------------------------------------
# Logs & temp
# ---------------------------------------------------------------
*.log
logs/
tmp/
temp/
*.tmp
*.bak
*.swp
*.swo

# ---------------------------------------------------------------
# Editors / IDE
# ---------------------------------------------------------------
.vscode/
!.vscode/extensions.json
.idea/
*.iml
*.sublime-project
*.sublime-workspace

# ---------------------------------------------------------------
# OS junk
# ---------------------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
