# Copy this file to `.env` (same folder) and fill in your keys.
# `.env` is gitignored — never commit real keys.

# --- Required for `--source youtube` -----------------------------------
# Get one at https://console.cloud.google.com/
#   1. Create a project
#   2. APIs & Services → Library → enable "YouTube Data API v3"
#   3. APIs & Services → Credentials → Create credentials → API key
# Free tier: 10,000 quota units/day. A search costs 100, a comment page costs 1.
YOUTUBE_API_KEY=

# --- Optional: Reddit source (`--source reddit`) -----------------------
# Free. Create a "script" app at https://www.reddit.com/prefs/apps
#   - client id is the short string UNDER the app name
#   - redirect URI can be http://localhost:8080 (unused for script apps)
# Limit: 100 queries/minute. Anonymous access no longer works at all.
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=

# --- Optional: Threads source (`--source threads`) ---------------------
# Needs a Meta app + a linked Threads account + OAuth, not just a key, and the
# 'threads_keyword_search' permission requires app review. Note that Threads
# cannot return replies to other people's posts at all — only top-level posts
# matching a keyword. See src/threads_client.py before investing time here.
THREADS_ACCESS_TOKEN=

# --- Optional: only for `--analyzer llm` -------------------------------
# Upgrades sentiment/segment judgment from the lexicon baseline to Claude.
# Requires: pip install anthropic
ANTHROPIC_API_KEY=
